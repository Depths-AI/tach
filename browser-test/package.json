{
  "name": "@tach/browser-test",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone headless-browser and WebGPU harness for Tach-generated modules",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:examples": "node scripts/build-examples.mjs",
    "install:browser": "playwright install --with-deps chromium",
    "start": "node server.mjs",
    "test": "npm run build:examples && playwright test",
    "test:interface": "npm run build:examples && playwright test tests/interface.spec.mjs",
    "test:headed": "npm run build:examples && playwright test --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  }
}
