{
  "name": "@tach/browser-test",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Private headless-browser and WebGPU harness for Tach-generated modules",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:examples": "node scripts/build-examples.mjs",
    "install:browser": "playwright install --with-deps chromium",
    "start": "node server.mjs",
    "test": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@depths/tach": "0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  }
}
