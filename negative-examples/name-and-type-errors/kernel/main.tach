function unknownName(): float32 {
  return misspelled;
}

export function wrongType[i](out: buffer<float32[]>) {
  if (i < out.length) {
    out[i] = true;
  }
}

function wrongBounds(): bool {
  return min(true, false);
}

export function wrongAtomic[i](state: buffer<uint32[]>) {
  atomicCompareExchange(state[i], 0, 1);
}
