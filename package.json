{
  "name": "tach-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "tach-ts",
    "browser-test",
    "showcase-ts"
  ],
  "scripts": {
    "compiler": "go build -o dist/ .",
    "build": "npm run compiler && npm run build --workspaces --if-present",
    "check": "npm run compiler && npm run check --workspaces --if-present",
    "test": "npm run compiler && npm test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
