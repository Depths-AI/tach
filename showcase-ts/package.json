{
  "name": "@tach/showcase-ts",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Large GPU workload showcase for Tach and WebGPU",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "kernel": "node scripts/build-kernels.mjs",
    "check": "npm run kernel && tsc --noEmit",
    "build": "npm run check && vite build",
    "install:browser": "playwright install chromium",
    "benchmark": "npm run build && playwright test",
    "test": "npm run benchmark"
  },
  "dependencies": {
    "@depths/tach": "0.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
