@docs(
  title("Procedural world rendering"),
  summary("Traces, lights, and post-processes a complete 1080p analytic scene entirely on the GPU."),
);

import "shared/color";
@docs(
  summary("Frame dimensions and animation time."),
  field(width, "Output width in pixels."),
  field(height, "Output height in pixels."),
  field(time, "Continuous scene time."),
)
type ProceduralParams = {
  width: uint32,
  height: uint32,
  time: float32,
};

@docs(
  summary("Computes signed distance to an axis-aligned box."),
  param(point, "Position relative to the box center."),
  param(halfSize, "Box half extents."),
  returns("Signed distance to the box."),
)
function boxDistance(point: vec<float32, 3>, halfSize: vec<float32, 3>): float32 {
  const q = abs(point) - halfSize;
  const outside = length(
    vec(q.x > 0.0 ? q.x : 0.0, q.y > 0.0 ? q.y : 0.0, q.z > 0.0 ? q.z : 0.0),
  );
  let inside = q.x;
  if (q.y > inside) {
    inside = q.y;
  }
  if (q.z > inside) {
    inside = q.z;
  }
  return outside + (inside < 0.0 ? inside : 0.0);
}

@docs(
  summary("Evaluates the analytic world's nearest signed distance."),
  param(point, "World-space sample position."),
  param(time, "Scene animation time."),
  returns("Distance to the closest surface."),
)
function sceneDistance(point: vec<float32, 3>, time: float32): float32 {
  const terrain = point.y + 1.05 - sin(point.x * 0.72 + time * 0.18) * 0.16
    - cos(point.z * 0.55) * 0.12;
  const sphere = length(point - vec(-1.15 + sin(time * 0.3) * 0.25, -0.05, 3.8)) - 0.82;
  const tower = boxDistance(point - vec(1.2, -0.05, 4.8), vec(0.62, 1.0, 0.62));
  const ringPoint = point - vec(0.15, -0.15, 6.2);
  const ring = length(vec(length(ringPoint.xz) - 1.05, ringPoint.y)) - 0.22;
  let nearest = terrain;
  if (sphere < nearest) {
    nearest = sphere;
  }
  if (tower < nearest) {
    nearest = tower;
  }
  if (ring < nearest) {
    nearest = ring;
  }
  return nearest;
}

@docs(
  summary("Sphere-traces one camera ray into a compact surface buffer."),
  coordinate(i, "Linear pixel index."),
  param(surface, "World position and hit distance per pixel."),
  param(params, "Frame dimensions and scene time."),
)
function trace[i](surface: buffer<vec<float32, 4>[]>, params: ProceduralParams) {
  const x = i % params.width;
  const y = i / params.width;
  const aspect = float32(params.width) / float32(params.height);
  const u = (2.0 * (float32(x) + 0.5) / float32(params.width) - 1.0) * aspect;
  const v = 1.0 - 2.0 * (float32(y) + 0.5) / float32(params.height);
  const origin = vec(0.0, 0.35, -4.2);
  const direction = normalize(vec(u, v, 1.72));
  let travel = 0.0;
  let distance = 1.0;
  let point = origin;
  let step = 0;
  while (step < 72 && travel < 18.0 && distance > 0.0018) {
    point = origin + direction * travel;
    distance = sceneDistance(point, params.time);
    travel += distance > 0.0018 ? distance : 0.0018;
    step++;
  }
  const hit = distance <= 0.006 && travel < 18.0;
  surface[i] = vec(point, hit ? travel : -1.0);
}

@docs(
  summary("Evaluates normals, soft sunlight, ambient occlusion, material response, and fog."),
  coordinate(i, "Linear pixel index."),
  param(surface, "Traced surface samples."),
  param(hdr, "Linear high-dynamic-range output."),
  param(params, "Frame dimensions and scene time."),
)
function light[i](
  surface: buffer<vec<float32, 4>[]>,
  hdr: buffer<vec<float32, 4>[]>,
  params: ProceduralParams,
) {
  const sample = surface[i];
  const y = i / params.width;
  const skyAmount = float32(y) / float32(params.height);
  let color = vec(0.10 + skyAmount * 0.12, 0.18 + skyAmount * 0.18, 0.32 + skyAmount * 0.24);
  if (sample.w > 0.0) {
    const point = sample.xyz;
    const epsilon = 0.004;
    const center = sceneDistance(point, params.time);
    // Surface orientation is reconstructed from distance-field gradients.
    const normal = normalize(vec(
      sceneDistance(point + vec(epsilon, 0.0, 0.0), params.time) - center,
      sceneDistance(point + vec(0.0, epsilon, 0.0), params.time) - center,
      sceneDistance(point + vec(0.0, 0.0, epsilon), params.time) - center,
    ));
    const sun = normalize(vec(-0.55, 0.78, -0.32));
    let shadow = 1.0;
    let shadowTravel = 0.035;
    for (let shadowStep = 0; shadowStep < 8; shadowStep++) {
      const shadowDistance = sceneDistance(
        point + normal * 0.012 + sun * shadowTravel,
        params.time,
      );
      const candidate = 10.0 * shadowDistance / shadowTravel;
      if (candidate < shadow) {
        shadow = candidate;
      }
      shadowTravel += shadowDistance < 0.025
        ? 0.025 : shadowDistance > 0.45 ? 0.45 : shadowDistance;
    }
    shadow = saturate(shadow);
    let occlusion = 0.0;
    for (let aoStep = 1; aoStep <= 3; aoStep++) {
      const radius = float32(aoStep) * 0.075;
      const gap = radius - sceneDistance(point + normal * radius, params.time);
      occlusion += (gap > 0.0 ? gap : 0.0) / float32(aoStep);
    }
    const ambient = saturate(1.0 - occlusion * 2.1);
    const diffuseRaw = dot(normal, sun);
    const diffuse = (diffuseRaw > 0.0 ? diffuseRaw : 0.0) * shadow;
    const view = normalize(vec(0.0, 0.35, -4.2) - point);
    const specularRaw = dot(normal, normalize(sun + view));
    const specular = pow(specularRaw > 0.0 ? specularRaw : 0.0, 28.0) * shadow;
    const terrainBands = 0.5 + 0.5 * sin(point.x * 3.7 + point.z * 2.3);
    const objectBands = 0.5 + 0.5 * sin(point.x * 7.0 + point.y * 4.0 + point.z * 5.0);
    const base = point.y < -0.72
      ? vec(0.12 + terrainBands * 0.16, 0.23 + terrainBands * 0.22, 0.08) : vec(
      0.18 + objectBands * 0.42,
      0.12 + (1.0 - objectBands) * 0.24,
      0.22 + objectBands * 0.36,
    );
    const lit = base * (0.12 + ambient * 0.22 + diffuse * 1.15) + vec(1.0, 0.82, 0.58) * specular
      * 0.65;
    const fog = saturate(sample.w / 18.0);
    color = lit * (1.0 - fog * 0.62) + vec(0.16, 0.23, 0.34) * fog * 0.62;
  }
  hdr[i] = vec(color, 1.0);
}

@docs(
  summary("Applies a spatial reconstruction filter, tone mapping, and vignette."),
  coordinate(i, "Linear pixel index."),
  param(hdr, "Linear frame produced by lighting."),
  param(frame, "Linear display frame."),
  param(params, "Frame dimensions."),
)
function proceduralPost[i](
  hdr: buffer<vec<float32, 4>[]>,
  frame: buffer<vec<float32, 4>[]>,
  params: ProceduralParams,
) {
  if (i < frame.length) {
    const x = i % params.width;
    const y = i / params.width;
    const left = hdr[x > 0 ? i - 1 : i].xyz;
    const right = hdr[x + 1 < params.width ? i + 1 : i].xyz;
    const up = hdr[y > 0 ? i - params.width : i].xyz;
    const down = hdr[y + 1 < params.height ? i + params.width : i].xyz;
    const center = hdr[i].xyz;
    const blur = (left + right + up + down) * 0.125 + center * 0.5;
    let color = center * 1.12 - blur * 0.12;
    color = color / (color + 1.0);
    const nx = float32(x) / float32(params.width) * 2.0 - 1.0;
    const ny = float32(y) / float32(params.height) * 2.0 - 1.0;
    const vignette = saturate(1.08 - (nx * nx + ny * ny) * 0.24);
    frame[i] = vec(color * vignette, 1.0);
  }
}

@docs(
  summary("Renders one complete procedural world frame."),
  param(params, "Frame dimensions and animation time."),
  returns("The complete sRGB display view."),
)
export function proceduralWorld(params: ProceduralParams): view<srgb8> {
  const count = params.width * params.height;
  const surface = transient<vec<float32, 4>>(count);
  const hdr = transient<vec<float32, 4>>(count);
  const frame = transient<vec<float32, 4>>(count);
  run trace(surface, params) over count;
  run light(surface, hdr, params) over count;
  run proceduralPost(hdr, frame, params) over count;
  return view(frame, params.width, params.height);
}
