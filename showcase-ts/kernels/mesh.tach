@docs(
  title("Arbitrary mesh rendering"),
  summary("Renders heterogeneous smooth indexed geometry through a compute-only visibility and material pipeline."),
);

import "shared/color";
@docs(
  summary("Viewport, camera, and lighting parameters."),
  field(width, "Output width in pixels."),
  field(height, "Output height in pixels."),
  field(time, "Continuous camera and lighting time."),
)
type MeshParams = {
  width: uint32,
  height: uint32,
  time: float32,
};

@docs(
  summary("Evaluates a signed screen-space edge function."),
  param(a, "First edge endpoint."),
  param(b, "Second edge endpoint."),
  param(point, "Pixel center under test."),
  returns("Signed twice-area relative to the edge."),
)
function edge(a: float32x2, b: float32x2, point: float32x2): float32 {
  return (point.x - a.x) * (b.y - a.y) - (point.y - a.y) * (b.x - a.x);
}

@docs(
  summary("Chooses a spatially detailed base color for one material family."),
  param(material, "Interpolated material identifier."),
  param(world, "Interpolated world position."),
  returns("Linear base color."),
)
function materialColor(material: float32, world: float32x3): float32x3 {
  const grain = 0.5 + 0.5 * sin(world.x * 7.1 + world.y * 4.3 + world.z * 5.7);
  if (material < 0.5) {
    const terrain = 0.5 + 0.5 * sin(world.x * 1.8) * cos(world.z * 1.4);
    return float32x3(0.10 + terrain * 0.10, 0.20 + terrain * 0.20, 0.07 + grain * 0.05);
  }
  if (material < 1.5) {
    return float32x3(0.32 + grain * 0.48, 0.12 + grain * 0.22, 0.035 + grain * 0.08);
  }
  if (material < 2.5) {
    return float32x3(0.04 + grain * 0.10, 0.24 + grain * 0.40, 0.34 + (1.0 - grain) * 0.52);
  }
  if (material < 3.5) {
    return float32x3(0.34 + grain * 0.42, 0.035 + grain * 0.10, 0.16 + (1.0 - grain) * 0.32);
  }
  if (material < 4.5) {
    return float32x3(0.15 + grain * 0.18, 0.30 + grain * 0.46, 0.08 + grain * 0.14);
  }
  return float32x3(0.28 + grain * 0.32, 0.22 + grain * 0.30, 0.38 + (1.0 - grain) * 0.34);
}

@docs(
  summary("Computes one attenuated Lambertian point-light contribution."),
  param(world, "Shaded world position."),
  param(normal, "Unit surface normal."),
  param(position, "Point-light position."),
  param(color, "Point-light color."),
  param(power, "Point-light intensity."),
  returns("RGB irradiance contribution."),
)
function pointLight(
  world: float32x3,
  normal: float32x3,
  position: float32x3,
  color: float32x3,
  power: float32,
): float32x3 {
  const offset = position - world;
  const distanceSquared = dot(offset, offset) + 0.05;
  const direction = offset * rsqrt(distanceSquared);
  const cosineRaw = dot(normal, direction);
  const cosine = cosineRaw > 0.0 ? cosineRaw : 0.0;
  return color * (cosine * power / (1.0 + distanceSquared * 0.10));
}

@docs(
  summary("Projects arbitrary world vertices while retaining reciprocal depth for perspective-correct reconstruction."),
  coordinate(i, "Vertex index."),
  param(vertices, "World XYZ and material identifier per vertex."),
  param(screen, "Projected XY, normalized depth, and reciprocal view depth."),
  param(params, "Viewport and camera time."),
)
function transform[i](
  vertices: buffer<float32x4[]>,
  screen: buffer<float32x4[]>,
  params: MeshParams,
) {
  const vertex = vertices[i];
  const camera = float32x3(sin(params.time * 0.17) * 0.35, 2.15, -4.0);
  const view = vertex.xyz - camera;
  const inverseDepth = 1.0 / view.z;
  screen[i] = float32x4(
    (view.x * inverseDepth * 0.90 + 0.5) * float32(params.width),
    (0.53 - view.y * inverseDepth * 1.48) * float32(params.height),
    saturate((view.z - 5.0) / 42.0),
    inverseDepth,
  );
}

@docs(
  summary("Clears packed depth and primitive ownership."),
  coordinate(i, "Pixel index."),
  param(visibility, "Atomic depth and triangle ownership image."),
)
function clear[i](visibility: buffer<atomic<uint32>[]>) {
  if (i < visibility.length) {
    atomicStore(visibility[i], 0xffff_ffff);
  }
}

@docs(
  summary("Rasterizes one indexed triangle and atomically resolves visible fragments."),
  coordinate(triangle, "Triangle index."),
  param(screen, "Projected vertices."),
  param(indices, "Three vertex indices per triangle."),
  param(visibility, "Atomic depth and triangle ownership image."),
  param(coverage, "Covered-fragment count per triangle."),
  param(params, "Viewport dimensions."),
)
function rasterize[triangle](
  screen: buffer<float32x4[]>,
  indices: buffer<uint32[]>,
  visibility: buffer<atomic<uint32>[]>,
  coverage: buffer<uint32[]>,
  params: MeshParams,
) {
  const first = triangle * 3;
  let covered = 0;
  if (first + 2 < indices.length && triangle < 0x000f_ffff) {
    const a = screen[indices[first]];
    const b = screen[indices[first + 1]];
    const c = screen[indices[first + 2]];
    const area = edge(a.xy, b.xy, c.xy);
    const areaMagnitude = abs(area);
    if (areaMagnitude > 0.0001) {
      const minimumX = a.x < b.x
        ? (a.x < c.x ? a.x : c.x) : (b.x < c.x ? b.x : c.x);
      const minimumY = a.y < b.y
        ? (a.y < c.y ? a.y : c.y) : (b.y < c.y ? b.y : c.y);
      const maximumX = a.x > b.x
        ? (a.x > c.x ? a.x : c.x) : (b.x > c.x ? b.x : c.x);
      const maximumY = a.y > b.y
        ? (a.y > c.y ? a.y : c.y) : (b.y > c.y ? b.y : c.y);
      const x0 = clamp(int32(floor(minimumX)), 0, int32(params.width) - 1);
      const y0 = clamp(int32(floor(minimumY)), 0, int32(params.height) - 1);
      const x1 = clamp(int32(ceil(maximumX)), 0, int32(params.width) - 1);
      const y1 = clamp(int32(ceil(maximumY)), 0, int32(params.height) - 1);
      for (let y = y0; y <= y1; y++) {
        for (let x = x0; x <= x1; x++) {
          const point = float32x2(float32(x) + 0.5, float32(y) + 0.5);
          const wa = edge(b.xy, c.xy, point) / area;
          const wb = edge(c.xy, a.xy, point) / area;
          const wc = 1.0 - wa - wb;
          if (wa >= 0.0 && wb >= 0.0 && wc >= 0.0) {
            const depth = saturate(wa * a.z + wb * b.z + wc * c.z);
            atomicMin(
              visibility[uint32(y) * params.width + uint32(x)],
              (uint32(depth * 4094.0) << 20) | triangle,
            );
            covered++;
          }
        }
      }
    }
  }
  coverage[triangle] = covered;
}

@docs(
  summary("Reconstructs perspective-correct surface attributes and evaluates smooth heterogeneous materials."),
  coordinate(i, "Pixel index."),
  param(vertices, "World XYZ and material identifier per vertex."),
  param(normals, "World normal and roughness per vertex."),
  param(screen, "Projected vertices and reciprocal depths."),
  param(indices, "Triangle index data."),
  param(visibility, "Resolved depth and triangle ownership image."),
  param(hdr, "Linear high-dynamic-range output."),
  param(params, "Viewport and lighting time."),
)
function shade[i](
  vertices: buffer<float32x4[]>,
  normals: buffer<float32x4[]>,
  screen: buffer<float32x4[]>,
  indices: buffer<uint32[]>,
  visibility: buffer<atomic<uint32>[]>,
  hdr: buffer<float32x4[]>,
  params: MeshParams,
) {
  const x = i % params.width;
  const y = i / params.width;
  const owner = atomicLoad(visibility[i]);
  const sky = float32(y) / float32(params.height);
  let color = float32x3(0.07 + sky * 0.12, 0.13 + sky * 0.19, 0.25 + sky * 0.30);
  if (owner != 0xffff_ffff) {
    const triangle = owner & 0x000f_ffff;
    const first = triangle * 3;
    const ia = indices[first];
    const ib = indices[first + 1];
    const ic = indices[first + 2];
    const va = vertices[ia];
    const vb = vertices[ib];
    const vc = vertices[ic];
    const na = normals[ia];
    const nb = normals[ib];
    const nc = normals[ic];
    const sa = screen[ia];
    const sb = screen[ib];
    const sc = screen[ic];
    const point = float32x2(float32(x) + 0.5, float32(y) + 0.5);
    const area = edge(sa.xy, sb.xy, sc.xy);
    const screenA = edge(sb.xy, sc.xy, point) / area;
    const screenB = edge(sc.xy, sa.xy, point) / area;
    const screenC = 1.0 - screenA - screenB;
    const reciprocalDepth = screenA * sa.w + screenB * sb.w + screenC * sc.w;
    // Reciprocal-depth weights restore perspective-correct world attributes.
    const wa = screenA * sa.w / reciprocalDepth;
    const wb = screenB * sb.w / reciprocalDepth;
    const wc = 1.0 - wa - wb;
    const world = va.xyz * wa + vb.xyz * wb + vc.xyz * wc;
    const rawNormal = normalize(na.xyz * wa + nb.xyz * wb + nc.xyz * wc);
    const camera = float32x3(sin(params.time * 0.17) * 0.35, 2.15, -4.0);
    const view = normalize(camera - world);
    const facing = dot(rawNormal, view);
    const normal = facing >= 0.0 ? rawNormal : -rawNormal;
    const material = va.w * wa + vb.w * wb + vc.w * wc;
    const roughness = saturate(na.w * wa + nb.w * wb + nc.w * wc);
    let occlusion = 0.0;
    const depthCode = owner >> 20;
    if (x > 0) {
      const neighbor = atomicLoad(visibility[i - 1]);
      if (neighbor != 0xffff_ffff && (neighbor >> 20) + 16 < depthCode) {
        occlusion += 0.14;
      }
    }
    if (x + 1 < params.width) {
      const neighbor = atomicLoad(visibility[i + 1]);
      if (neighbor != 0xffff_ffff && (neighbor >> 20) + 16 < depthCode) {
        occlusion += 0.14;
      }
    }
    if (y > 0) {
      const neighbor = atomicLoad(visibility[i - params.width]);
      if (neighbor != 0xffff_ffff && (neighbor >> 20) + 16 < depthCode) {
        occlusion += 0.14;
      }
    }
    if (y + 1 < params.height) {
      const neighbor = atomicLoad(visibility[i + params.width]);
      if (neighbor != 0xffff_ffff && (neighbor >> 20) + 16 < depthCode) {
        occlusion += 0.14;
      }
    }
    const sun = normalize(float32x3(-0.48, 0.80, -0.35));
    const diffuseRaw = dot(normal, sun);
    const diffuse = diffuseRaw > 0.0 ? diffuseRaw : 0.0;
    const specularRaw = dot(normal, normalize(sun + view));
    const specular = pow(specularRaw > 0.0
      ? specularRaw : 0.0, 8.0 + (1.0 - roughness) * 72.0);
    const local = pointLight(
      world,
      normal,
      float32x3(-6.0, 6.0, 8.0),
      float32x3(1.0, 0.22, 0.08),
      13.0,
    )
      + pointLight(
      world,
      normal,
      float32x3(6.0, 4.0, 13.0),
      float32x3(0.08, 0.35, 1.0),
      15.0,
    )
      + pointLight(
      world,
      normal,
      float32x3(0.0, 7.0, 22.0),
      float32x3(0.34, 1.0, 0.44),
      17.0,
    );
    const base = materialColor(material, world);
    const lit = base * ((0.16 + diffuse * 1.08) * (1.0 - occlusion)) + local
      + float32x3(1.0, 0.86, 0.68) * specular * (0.25 + (1.0 - roughness) * 0.70);
    const fog = saturate((world.z - 16.0) / 28.0);
    color = lit * (1.0 - fog * 0.58) + float32x3(0.13, 0.20, 0.31) * fog * 0.58;
  }
  hdr[i] = float32x4(color, 1.0);
}

@docs(
  summary("Applies neighborhood bloom, tone mapping, gamma, and vignette."),
  coordinate(i, "Pixel index."),
  param(hdr, "Linear lit frame."),
  param(pixels, "Packed display frame."),
  param(params, "Frame dimensions."),
)
function meshPost[i](
  hdr: buffer<float32x4[]>,
  pixels: buffer<uint32[]>,
  params: MeshParams,
) {
  if (i < pixels.length) {
    const x = i % params.width;
    const y = i / params.width;
    const center = hdr[i].xyz;
    const left = hdr[x > 0 ? i - 1 : i].xyz;
    const right = hdr[x + 1 < params.width ? i + 1 : i].xyz;
    const up = hdr[y > 0 ? i - params.width : i].xyz;
    const down = hdr[y + 1 < params.height ? i + params.width : i].xyz;
    const bloom = (left + right + up + down) * 0.055;
    const bloomLuminance = dot(bloom, float32x3(0.21, 0.72, 0.07));
    let color = center + bloom * (bloomLuminance > 0.34 ? 0.50 : 0.07);
    color = color / (color + 1.0);
    const nx = float32(x) / float32(params.width) * 2.0 - 1.0;
    const ny = float32(y) / float32(params.height) * 2.0 - 1.0;
    pixels[i] = packColor(sqrt(color) * saturate(1.08 - (nx * nx + ny * ny) * 0.20));
  }
}

@docs(
  summary("Renders one complete frame of arbitrary smooth indexed geometry."),
  param(vertices, "World XYZ and material identifier per vertex."),
  param(normals, "World normal and roughness per vertex."),
  param(indices, "Three vertex indices per triangle."),
  param(visibility, "Atomic depth and triangle ownership storage."),
  param(coverage, "Covered-fragment count per triangle."),
  param(pixels, "Packed 1080p output frame."),
  param(params, "Viewport, camera, and lighting parameters."),
)
export function meshWorld(
  vertices: buffer<float32x4[]>,
  normals: buffer<float32x4[]>,
  indices: buffer<uint32[]>,
  visibility: buffer<atomic<uint32>[]>,
  coverage: buffer<uint32[]>,
  pixels: buffer<uint32[]>,
  params: MeshParams,
) {
  const screen = transient<float32x4>(vertices.length);
  const hdr = transient<float32x4>(pixels.length);
  run transform(vertices, screen, params) over vertices.length;
  run clear(visibility) over visibility.length;
  run rasterize(screen, indices, visibility, coverage, params) over indices.length / 3;
  run shade(vertices, normals, screen, indices, visibility, hdr, params) over pixels.length;
  run meshPost(hdr, pixels, params) over pixels.length;
}
