type ParticleParams = {
  dt: float32,
  count: uint32,
  steps: uint32,
};

type FractalParams = {
  width: uint32,
  height: uint32,
  maxIterations: uint32,
  scale: float32,
  centerX: float32,
  centerY: float32,
};

type MatrixParams = {
  size: uint32,
};

type OptionParams = {
  count: uint32,
};

type RenderParams = {
  width: uint32,
  height: uint32,
  time: float32,
};

function normalCDF(x: float32): float32 {
  const magnitude = abs(x);
  const t = 1.0 / (1.0 + 0.2316419 * magnitude);
  const polynomial = t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))));
  const density = 0.398942280 * exp(-0.5 * magnitude * magnitude);
  const positive = 1.0 - density * polynomial;
  return x < 0.0 ? 1.0 - positive : positive;
}

function saturate(x: float32): float32 {
  return x < 0.0 ? 0.0 : x > 1.0 ? 1.0 : x;
}

function smoothRange(edge0: float32, edge1: float32, x: float32): float32 {
  const t = saturate((x - edge0) / (edge1 - edge0));
  return t * t * (3.0 - 2.0 * t);
}

function blend(base: float32, layer: float32, amount: float32): float32 {
  return base + (layer - base) * saturate(amount);
}

function hashPixel(x: uint32, y: uint32): float32 {
  let value = x * 374761393 + y * 668265263;
  value = (value ^ (value >> 13)) * 1274126177;
  value ^= value >> 16;
  return float32(value & 65535) / 65535.0;
}

export function integrateParticles[i](
  positions: buffer<float32[]>,
  velocities: buffer<float32[]>,
  params: ParticleParams,
) {
  if (i < params.count) {
    for (let step = 0; step < params.steps; step++) {
      positions[i] += velocities[i] * params.dt;
    }
  }
}

export function mandelbrot[x, y](
  output: buffer<uint32[]>,
  params: FractalParams,
) {
  if (x >= params.width || y >= params.height) {
    return;
  }

  const cx = (float32(x) - float32(params.width) * 0.5) * params.scale + params.centerX;
  const cy = (float32(y) - float32(params.height) * 0.5) * params.scale + params.centerY;
  let zx = 0.0;
  let zy = 0.0;
  let iteration = 0;
  while (iteration < params.maxIterations && zx * zx + zy * zy <= 4.0) {
    const nextX = zx * zx - zy * zy + cx;
    zy = 2.0 * zx * zy + cy;
    zx = nextX;
    iteration++;
  }
  output[y * params.width + x] = iteration;
}

@workgroup(16, 16)
export function multiplyMatrices[column, row](
  left: buffer<float32[]>,
  right: buffer<float32[]>,
  output: buffer<float32[]>,
  params: MatrixParams,
) {
  let leftTile: shared<float32[256]>;
  let rightTile: shared<float32[256]>;

  const localColumn = column % 16;
  const localRow = row % 16;
  const local = localRow * 16 + localColumn;
  let sum = 0.0;
  let tile = 0;
  while (tile < params.size) {
    const leftColumn = tile + localColumn;
    const rightRow = tile + localRow;
    if (row < params.size && leftColumn < params.size) {
      leftTile[local] = left[row * params.size + leftColumn];
    } else {
      leftTile[local] = 0.0;
    }
    if (rightRow < params.size && column < params.size) {
      rightTile[local] = right[rightRow * params.size + column];
    } else {
      rightTile[local] = 0.0;
    }
    workgroupBarrier();

    for (let k = 0; k < 16; k++) {
      sum += leftTile[localRow * 16 + k] * rightTile[k * 16 + localColumn];
    }
    workgroupBarrier();
    tile += 16;
  }

  if (row < params.size && column < params.size) {
    output[row * params.size + column] = sum;
  }
}

export function priceOptions[i](
  output: buffer<float32[]>,
  params: OptionParams,
) {
  if (i >= params.count) {
    return;
  }

  const spot = 80.0 + float32(i % 400) * 0.1;
  const strike = 90.0 + float32(i % 200) * 0.1;
  const years = 0.25 + float32(i % 365) / 365.0;
  const volatility = 0.15 + float32(i % 100) * 0.001;
  const rate = 0.03;
  const sigmaRootTime = volatility * sqrt(years);
  const d1 = (log(spot / strike) + (rate + 0.5 * volatility * volatility) * years) / sigmaRootTime;
  const d2 = d1 - sigmaRootTime;
  output[i] = spot * normalCDF(d1) - strike * exp(-rate * years) * normalCDF(d2);
}

export function proceduralScene[x, y](
  rgba: buffer<uint32[]>,
  params: RenderParams,
) {
  if (x >= params.width || y >= params.height) {
    return;
  }

  const u = (float32(x) + 0.5) / float32(params.width);
  const v = (float32(y) + 0.5) / float32(params.height);
  const aspect = float32(params.width) / float32(params.height);
  const px = (u - 0.5) * aspect;
  const py = 0.5 - v;

  let red = 0.015 + 0.18 * v;
  let green = 0.025 + 0.06 * v;
  let blue = 0.11 + 0.22 * (1.0 - v);

  const cloudWave = 0.5 + 0.5 * sin(px * 5.0 + sin(py * 9.0 + params.time) * 1.7);
  const auroraHeight = 0.14 + 0.055 * sin(px * 3.2 + params.time * 0.7) +
    0.025 * sin(px * 11.0 - params.time);
  const aurora = exp(-abs(py - auroraHeight) * 20.0) * (0.35 + 0.65 * cloudWave);
  red += aurora * 0.08;
  green += aurora * 0.42;
  blue += aurora * 0.48;

  const sunX = px - 0.33;
  const sunY = py - 0.12;
  const sunDistance = sqrt(sunX * sunX + sunY * sunY);
  const halo = exp(-sunDistance * 7.0);
  const disk = smoothRange(0.145, 0.125, sunDistance);
  const rings = exp(-abs(sunDistance - 0.205) * 95.0) +
    0.55 * exp(-abs(sunDistance - 0.255) * 120.0);
  red += halo * 0.38 + rings * 0.55;
  green += halo * 0.08 + rings * 0.12;
  blue += halo * 0.16 + rings * 0.68;
  red = blend(red, 1.0, disk * 0.96);
  green = blend(green, 0.44 + 0.3 * (sunY / 0.145 + 0.5), disk * 0.96);
  blue = blend(blue, 0.16, disk * 0.96);

  const cellSize = 12;
  const cellX = x / cellSize;
  const cellY = y / cellSize;
  const seed = hashPixel(cellX, cellY);
  if (seed > 0.91 && py > -0.06) {
    const centerX = 2.0 + hashPixel(cellX + 17, cellY + 31) * 8.0;
    const centerY = 2.0 + hashPixel(cellX + 47, cellY + 11) * 8.0;
    const starX = float32(x % cellSize) - centerX;
    const starY = float32(y % cellSize) - centerY;
    const core = exp(-(starX * starX + starY * starY) * 1.7);
    const rays = 0.22 * exp(-abs(starX) * 4.0 - abs(starY) * 0.45) +
      0.22 * exp(-abs(starY) * 4.0 - abs(starX) * 0.45);
    const sparkle = (core + rays) * (0.45 + seed * 0.8);
    red += sparkle;
    green += sparkle * 0.88;
    blue += sparkle * 1.15;
  }

  const distantHeight = -0.075 + 0.045 * sin(px * 6.5 + 0.4) +
    0.022 * sin(px * 16.0 - 1.3);
  const distant = smoothRange(distantHeight + 0.018, distantHeight - 0.012, py);
  red = blend(red, 0.075, distant);
  green = blend(green, 0.045, distant);
  blue = blend(blue, 0.16, distant);
  const ridge = exp(-abs(py - distantHeight) * 150.0);
  red += ridge * 0.24;
  blue += ridge * 0.38;

  const nearHeight = -0.19 + 0.065 * sin(px * 4.3 - 0.8) +
    0.038 * sin(px * 12.5 + 1.7);
  const near = smoothRange(nearHeight + 0.014, nearHeight - 0.018, py);
  red = blend(red, 0.018, near);
  green = blend(green, 0.025, near);
  blue = blend(blue, 0.055, near);

  const ground = smoothRange(-0.20, -0.235, py);
  const perspective = 0.57 + py;
  const verticalGrid = exp(-abs(sin(px * 14.0 / perspective)) * 22.0);
  const horizontalGrid = exp(-abs(sin(1.35 / perspective + params.time * 0.35)) * 24.0);
  const grid = saturate(verticalGrid + horizontalGrid);
  const reflection = exp(-abs(px - 0.33) * 7.0) *
    (0.45 + 0.55 * sin(py * 210.0 + sin(px * 19.0) * 2.0));
  red = blend(red, 0.018 + grid * 0.55 + reflection * 0.32, ground);
  green = blend(green, 0.035 + grid * 0.12 + reflection * 0.06, ground);
  blue = blend(blue, 0.09 + grid * 0.72 + reflection * 0.42, ground);

  const vignette = saturate(1.0 - (px * px * 0.5 + (v - 0.5) * (v - 0.5)) * 1.35);
  const grain = 0.97 + hashPixel(x + 101, y + 79) * 0.06;
  const scanline = 0.975 + 0.025 * sin(float32(y) * 1.65);
  const exposure = (0.62 + 0.38 * vignette) * grain * scanline;
  red *= exposure;
  green *= exposure;
  blue *= exposure;
  const alpha = 0.94 + 0.06 * vignette;

  const red8 = uint32(saturate(red) * 255.0 + 0.5);
  const green8 = uint32(saturate(green) * 255.0 + 0.5);
  const blue8 = uint32(saturate(blue) * 255.0 + 0.5);
  const alpha8 = uint32(saturate(alpha) * 255.0 + 0.5);
  rgba[y * params.width + x] = red8 | (green8 << 8) | (blue8 << 16) | (alpha8 << 24);
}
