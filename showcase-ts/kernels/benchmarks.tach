@docs(
  title("Tach GPU benchmark kernels"),
  summary("Two-stage workloads for particle prediction, fractals, matrix products, option pricing, and procedural rendering.")
);

@docs(
  summary("Particle workload dimensions and integration step."),
  field(count, "Number of particle components dispatched by the host."),
  field(dt, "Prediction time step.")
)
type ParticleParams = { count: uint32, dt: float32 };

@docs(
  summary("Dimensions and continuous parameters for image workloads."),
  field(width, "Image width in pixels."),
  field(height, "Image height in pixels."),
  field(scale, "Complex-plane distance represented by one fractal pixel."),
  field(time, "Animation time used by the procedural field.")
)
type ImageParams = { width: uint32, height: uint32, scale: float32, time: float32 };

@docs(
  summary("Logical element count supplied with a benchmark launch."),
  field(count, "Number of elements dispatched by the host.")
)
type CountParams = { count: uint32 };

@docs(
  summary("Performs one quadratic Mandelbrot orbit iteration."),
  param(z, "Current complex orbit value."),
  param(c, "Complex point being evaluated."),
  returns("The next complex orbit value.")
)
function fractalStep(z: float32x2, c: float32x2): float32x2 {
  return float32x2(z.x * z.x - z.y * z.y + c.x, 2.0 * z.x * z.y + c.y);
}

@docs(
  summary("Performs two Mandelbrot orbit iterations."),
  param(z, "Initial complex orbit value."),
  param(c, "Complex point being evaluated."),
  returns("The orbit value after two iterations.")
)
function fractal2(z: float32x2, c: float32x2): float32x2 {
  return fractalStep(fractalStep(z, c), c);
}

@docs(
  summary("Performs four Mandelbrot orbit iterations."),
  param(z, "Initial complex orbit value."),
  param(c, "Complex point being evaluated."),
  returns("The orbit value after four iterations.")
)
function fractal4(z: float32x2, c: float32x2): float32x2 {
  return fractal2(fractal2(z, c), c);
}

@docs(
  summary("Performs sixteen Mandelbrot orbit iterations through fixed composition."),
  param(z, "Initial complex orbit value."),
  param(c, "Complex point being evaluated."),
  returns("The orbit value after sixteen iterations.")
)
function fractal16(z: float32x2, c: float32x2): float32x2 {
  return fractal4(fractal4(fractal4(fractal4(z, c), c), c), c);
}

@docs(
  summary("Approximates the standard normal cumulative distribution."),
  param(x, "Standardized input value."),
  returns("Approximate probability that a standard normal variable is at most x.")
)
function normalCDF(x: float32): float32 {
  const a = abs(x);
  const t = 1.0 / (1.0 + 0.2316419 * a);
  // Polynomial coefficients form a compact single-precision CDF approximation.
  const p = t * (0.319381530 + t * (-0.356563782 + t * (1.781477937 + t * (-1.821255978 + t * 1.330274429))));
  const y = 1.0 - 0.398942280 * exp(-0.5 * a * a) * p;
  return x < 0.0 ? 1.0 - y : y;
}

@docs(
  summary("Clamps a scalar to the inclusive unit interval."),
  param(x, "Value to clamp."),
  returns("Zero below the interval, one above it, and x inside it.")
)
function saturate(x: float32): float32 {
  return x < 0.0 ? 0.0 : x > 1.0 ? 1.0 : x;
}

@docs(
  summary("Predicts particle components with one explicit Euler step."),
  coordinate(i, "Particle-component index."),
  param(positions, "Current particle components."),
  param(velocities, "Velocity components paired with the positions."),
  param(predicted, "Predicted components written for the commit stage."),
  param(params, "Workload count and prediction time step.")
)
export function particlePredict[i](positions: buffer<float32[]>, velocities: buffer<float32[]>, predicted: buffer<float32[]>, params: ParticleParams) {
  predicted[i] = positions[i] + velocities[i] * params.dt;
}

@docs(
  summary("Applies damping and a small bias to predicted particle components."),
  coordinate(i, "Particle-component index."),
  param(predicted, "Predicted components from the first stage."),
  param(output, "Final particle components written by this stage.")
)
export function particleCommit[i](predicted: buffer<float32[]>, output: buffer<float32[]>) {
  output[i] = predicted[i] * 0.99991 + 0.00003;
}

@docs(
  summary("Computes a fixed-depth Mandelbrot orbit magnitude for each pixel."),
  coordinate(i, "Linear pixel index."),
  param(orbit, "Squared orbit magnitudes written for colorization."),
  param(params, "Image dimensions and complex-plane scale.")
)
export function fractalOrbit[i](orbit: buffer<float32[]>, params: ImageParams) {
  const x = i % params.width;
  const y = i / params.width;
  // Center the pixel grid and translate it toward the informative Mandelbrot region.
  const c = float32x2((float32(x) - float32(params.width) * 0.5) * params.scale - 0.6, (float32(y) - float32(params.height) * 0.5) * params.scale);
  const z = fractal16(float32x2(0.0, 0.0), c);
  orbit[i] = dot(z, z);
}

@docs(
  summary("Maps orbit magnitudes to packed RGBA8 pixels."),
  coordinate(i, "Linear pixel index."),
  param(orbit, "Squared orbit magnitudes produced by fractalOrbit."),
  param(pixels, "Packed RGBA8 output pixels.")
)
export function fractalColor[i](orbit: buffer<float32[]>, pixels: buffer<uint32[]>) {
  const raw = log2(orbit[i] + 1.0) * 24.0;
  const value = uint32(raw < 0.0 ? 0.0 : raw > 255.0 ? 255.0 : raw);
  // Pack red, green, blue, and opaque alpha into one uint32 pixel.
  pixels[i] = value | ((value * 3) << 8) | ((255 - value) << 16) | (255 << 24);
}

@docs(
  summary("Computes one cell from each batched 4 × 4 matrix product."),
  coordinate(i, "Linear output-cell index across all matrix batches."),
  param(left, "Left-hand matrices in row-major order."),
  param(right, "Right-hand matrices in row-major order."),
  param(product, "Raw matrix-product cells written by this stage.")
)
export function matrixProduct[i](left: buffer<float32[]>, right: buffer<float32[]>, product: buffer<float32[]>) {
  const base = (i / 16) * 16;
  const cell = i % 16;
  // Split the linear cell into its row and column within one 4 × 4 matrix.
  const row = cell / 4;
  const column = cell % 4;
  product[i] = left[base + row * 4] * right[base + column] +
    left[base + row * 4 + 1] * right[base + 4 + column] +
    left[base + row * 4 + 2] * right[base + 8 + column] +
    left[base + row * 4 + 3] * right[base + 12 + column];
}

@docs(
  summary("Applies a bounded activation to matrix-product cells."),
  coordinate(i, "Linear matrix-cell index."),
  param(product, "Raw cells produced by matrixProduct."),
  param(output, "Activated matrix cells.")
)
export function matrixActivate[i](product: buffer<float32[]>, output: buffer<float32[]>) {
  const value = product[i];
  output[i] = value / (1.0 + abs(value));
}

@docs(
  summary("Prices a deterministic family of European call options with Black–Scholes."),
  coordinate(i, "Option index and deterministic input seed."),
  param(prices, "Calculated call prices."),
  param(params, "Logical option count paired with the host launch.")
)
export function optionPrice[i](prices: buffer<float32[]>, params: CountParams) {
  const spot = 80.0 + float32(i % 400) * 0.1;
  const strike = 90.0 + float32(i % 200) * 0.1;
  const years = 0.25 + float32(i % 365) / 365.0;
  const volatility = 0.15 + float32(i % 100) * 0.001;
  const root = volatility * sqrt(years);
  // d1 and d2 share root; the expression below uses d2 = d1 - root directly.
  const d1 = (log(spot / strike) + (0.03 + 0.5 * volatility * volatility) * years) / root;
  prices[i] = spot * normalCDF(d1) - strike * exp(-0.03 * years) * normalCDF(d1 - root);
}

@docs(
  summary("Adds a small nonlinear risk adjustment to option prices."),
  coordinate(i, "Option index."),
  param(prices, "Call prices produced by optionPrice."),
  param(output, "Risk-adjusted prices.")
)
export function optionRisk[i](prices: buffer<float32[]>, output: buffer<float32[]>) {
  const price = prices[i];
  output[i] = price + sqrt(abs(price)) * 0.01;
}

@docs(
  summary("Evaluates an animated radial and wave field for each pixel."),
  coordinate(i, "Linear pixel index."),
  param(field, "Procedural scalar field written for colorization."),
  param(params, "Image dimensions and animation time.")
)
export function renderField[i](field: buffer<float32[]>, params: ImageParams) {
  const x = i % params.width;
  const y = i / params.width;
  // Normalize pixel centers around the image origin before evaluating the field.
  const u = (float32(x) + 0.5) / float32(params.width) - 0.5;
  const v = (float32(y) + 0.5) / float32(params.height) - 0.5;
  const wave = sin(u * 31.0 + params.time) * cos(v * 23.0 - params.time);
  field[i] = exp(-sqrt(u * u + v * v) * 4.0) + wave * 0.35;
}

@docs(
  summary("Maps procedural field values to packed RGBA8 pixels."),
  coordinate(i, "Linear pixel index."),
  param(field, "Procedural values produced by renderField."),
  param(pixels, "Packed RGBA8 output pixels.")
)
export function renderColor[i](field: buffer<float32[]>, pixels: buffer<uint32[]>) {
  const value = saturate(field[i] * 0.5 + 0.5);
  const red = uint32(value * 255.0);
  const green = uint32(sqrt(value) * 255.0);
  const blue = uint32((1.0 - value) * 255.0);
  // Match the browser canvas path's little-endian RGBA8 packing.
  pixels[i] = red | (green << 8) | (blue << 16) | (255 << 24);
}
