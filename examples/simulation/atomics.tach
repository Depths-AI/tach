@docs(
  title("Atomic accumulation"),
  summary("Demonstrates workgroup memory, barriers, and atomic updates to shared GPU state."),
);

const accumulationWidth: uint32 = 8 * 8;
const accumulationSlots = accumulationWidth;
@docs(
  summary("Global counters updated atomically by the kernel."),
  field(total, "Number of lanes that observed an untouched workgroup slot."),
)
type Counters = {
  total: atomic<uint32>,
};

@docs(
  summary("Counts the first atomic update performed by each workgroup lane."),
  coordinate(i, "Global invocation index."),
  param(counters, "Global counter state updated by all workgroups."),
)
@workgroup(accumulationWidth)
export function accumulate[i](counters: buffer<Counters>) {
  let scratch: shared<atomic<uint32>[accumulationSlots]>;
  let lane = i % accumulationWidth;
  // Establish the explicit initialization before any lane uses shared state.
  if (lane == 0) {
    atomicStore(scratch[0], 0);
  }
  workgroupBarrier();
  let previous = atomicAdd(scratch[lane], 1);
  // Only the first update to a lane contributes to the global total.
  if (previous == 0) {
    atomicAdd(counters.total, 1);
  }
  bufferBarrier();
}
