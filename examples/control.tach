type Params = {
  scale: f32,
  count: u32,
};

@workgroup(64)
export compute transform[start](
  data: buffer<f32[]>,
  params: uniform<Params>,
) {
  let i = start;
  let acc = 0.0;

  while (i < params.count && acc < 1000.0) {
    acc += data[i] * params.scale;
    i += 64;
  }

  let out = acc;
  if (out > 100.0) {
    out = 100.0;
  } else {
    out += 1.0;
  }

  if (start < params.count) {
    data[start] = out;
  }
}
