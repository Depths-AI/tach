type Params = {
  scale: float32,
  count: uint32,
  enabled: bool,
};

@workgroup(64)
export function transform[start](
  data: buffer<float32[]>,
  params: Params,
) {
  let i = start;
  let acc = 0.0;

  while (i < params.count && acc < 1000.0) {
    acc += data[i] * params.scale;
    i += 64;
  }

  let out = acc;
  if (out > 100.0) {
    out = 100.0;
  } else {
    out += 1.0;
  }

  if (params.enabled && start < params.count) {
    data[start] = out;
  }
}
