type Counters = {
  total: atomic<uint32>,
};

@workgroup(64)
export function accumulate[i](counters: buffer<Counters>) {
  let scratch: shared<atomic<uint32>[64]>;
  const lane = i % 64;

  if (lane == 0) {
    atomicStore(scratch[0], 0);
  }
  workgroupBarrier();

  const previous = atomicAdd(scratch[lane], 1);
  if (previous == 0) {
    atomicAdd(counters.total, 1);
  }
  bufferBarrier();
}
