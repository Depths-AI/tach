export function bitwise[i](out: buffer<uint32[]>) {
  let u: uint32 = 0xff00;
  let s: int32 = -64;
  const left = u << 40;
  const logical = u >> 36;
  const arithmetic = s >> 35;
  let mixed = (left | logical) ^ ~u;
  mixed &= 0xffff;
  mixed <<= 33;
  if (i < out.length) {
    out[i] = mixed | uint32(arithmetic);
  }
}
