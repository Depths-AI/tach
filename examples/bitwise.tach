export compute bitwise[i](out: buffer<u32[]>) {
  let u: u32 = 0xff00;
  let s: i32 = -64;
  const left = u << 40;
  const logical = u >> 36;
  const arithmetic = s >> 35;
  let mixed = (left | logical) ^ ~u;
  mixed &= 0xffff;
  mixed <<= 33;
  if (i < out.length) {
    out[i] = mixed | u32(arithmetic);
  }
}
