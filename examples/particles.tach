@docs(
  title("Particle integration"),
  summary("Defines particle data and advances active particles with a reusable value helper.")
);

@docs(
  summary("Controls one particle-integration step."),
  field(dt, "Elapsed simulation time."),
  field(count, "Number of active particles.")
)
type Params = {
  dt: float32,
  count: uint32,
};

@docs(
  summary("Position and velocity for one particle."),
  field(position, "Current position vector."),
  field(velocity, "Velocity applied during integration.")
)
type Particle = {
  position: float32x4,
  velocity: float32x4,
};

@docs(
  summary("Advances one particle without mutating the input value."),
  param(p, "Particle state at the beginning of the step."),
  param(dt, "Elapsed simulation time."),
  returns("Particle state at the end of the step.")
)
function integrateParticle(p: Particle, dt: float32): Particle {
  return {
    position: p.position + p.velocity * dt,
    velocity: p.velocity,
  };
}

@docs(
  summary("Advances every active particle in place."),
  coordinate(i, "Particle index."),
  param(particles, "Particle storage updated by the integration step."),
  param(params, "Step duration and active-particle count.")
)
export function integrate[i](
  particles: buffer<Particle[]>,
  params: Params,
) {
  // Dispatches may be rounded beyond the active particle count.
  if (i >= params.count) {
    return;
  }
  particles[i] = integrateParticle(particles[i], params.dt);
}
