type Params = {
  dt: f32,
  count: u32,
};

type Particle = {
  position: f32x4,
  velocity: f32x4,
};

function integrateParticle(p: Particle, dt: f32): Particle {
  return {
    position: p.position + p.velocity * dt,
    velocity: p.velocity,
  };
}

export function integrate[i](
  particles: buffer<Particle[]>,
  params: uniform<Params>,
) {
  if (i >= params.count) {
    return;
  }
  particles[i] = integrateParticle(particles[i], params.dt);
}
