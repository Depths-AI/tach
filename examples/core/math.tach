@docs(
  title("Math intrinsics"),
  summary("Exercises Tach's portable scalar and vector mathematics in one kernel."),
);

const verticalAxis: vec<float32, 3> = vec(0.0, 1.0, 0.0);
@docs(
  summary("Evaluates vector geometry, trigonometry, exponentials, rounding, powers, and clamps."),
  coordinate(i, "Output vector index and numeric input seed."),
  param(out, "Four-component results for every in-range invocation."),
)
export function math[i](out: buffer<vec<float32, 4>[]>) {
  if (i < out.length) {
    // The first three lanes expose the normalized seed vector.
    let a = vec(float32(i) + 1.0, 2.0, 3.0);
    let b = normalize(a);
    let c = cross(a, verticalAxis);
    let len = length(a);
    let dist = distance(a, c);
    let projection = dot(a, b);
    let wave = sin(len) + cos(projection) + tan(0.25);
    let shaped = sqrt(abs(wave)) + rsqrt(len + 1.0);
    let expo = exp2(log2(len + 1.0)) + exp(log(len + 1.0));
    let powered = pow(len + 1.0, 2.0);
    let rounded = floor(powered) + ceil(dist) + trunc(shaped);
    let bounded: uint32 = clamp(min(i, 1024), 1, max(i, 1));
    // The final lane combines the scalar intrinsic results into one observable value.
    out[i] = vec(b.x, b.y, b.z, shaped + expo + rounded + float32(bounded));
  }
}
