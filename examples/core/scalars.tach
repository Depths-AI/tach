@docs(
  title("Scalar scaling"),
  summary("A minimal typed GPU kernel that scales a runtime-sized array in place."),
);

const halfScale: float16 = 0.5;
@docs(
  summary("Multiplies every in-range value by a scalar."),
  coordinate(i, "Value index."),
  param(data, "Values updated in place."),
  param(factor, "Multiplier applied to each value."),
)
export function scale[i](data: buffer<float32[]>, factor: float32) {
  // Workgroup rounding can produce coordinates beyond the runtime array.
  if (i < data.length) {
    data[i] *= factor;
  }
}

@docs(
  summary("Multiplies binary16 values without widening them to float32."),
  coordinate(i, "Value index."),
  param(data, "Binary16 values updated in place."),
  param(factor, "Binary16 multiplier applied to each value."),
)
export function scaleFloat16[i](data: buffer<float16[]>, factor: float16) {
  if (i < data.length) {
    data[i] *= factor;
  }
}

@docs(
  summary("Binary16 input with a scalar prefix and runtime-sized tail."),
  field(offset, "Value added after length normalization."),
  field(values, "Binary16 values consumed by the math kernel."),
)
type Float16Series = {
  offset: float16,
  values: float16[],
};

@docs(
  summary("Exercises binary16 scalar, vector, transcendental, and geometry math."),
  coordinate(i, "Output vector index."),
  param(input, "Prefixed binary16 runtime tail used as the math input."),
  param(output, "Binary16 results written in place."),
)
export function float16Math[i](
  input: buffer<Float16Series>,
  output: buffer<vec<float16, 4>[]>,
) {
  if (i < input.values.length && i < output.length) {
    let x = input.values[i] / float16(input.values.length) + input.offset;
    let value = vec(x, 2.0, 3.0);
    let unit = normalize(value);
    let boundedUnit = clamp(unit, -1.0, 1.0);
    let geometry = dot(value, boundedUnit) + length(value) + distance(value, boundedUnit)
      + cross(value, boundedUnit).x;
    let wave = sin(x) + cos(x) + tan(float16(0.25));
    let shaped = sqrt(abs(wave)) + rsqrt(x + 1.0);
    let exponential = exp2(log2(x + 1.0)) + exp(log(x + 1.0));
    let rounded = floor(pow(x + 1.0, 2.0)) + ceil(geometry) + trunc(shaped);
    output[i] = vec(boundedUnit, shaped + exponential + rounded);
  }
}

@docs(
  summary("Specializes the binary16 scale stage with a compiler-evaluated factor."),
  param(data, "Binary16 values updated in place."),
)
export function halveFloat16(data: buffer<float16[]>) {
  run scaleFloat16(data, halfScale) over data.length;
}
