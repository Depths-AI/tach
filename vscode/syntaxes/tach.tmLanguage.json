{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tach",
  "scopeName": "source.tach",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#members"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tach",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tach",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tach",
              "match": "\\\\(?:[\"\\\\/bfnrt]|u[0-9A-Fa-f]{4})"
            },
            {
              "name": "invalid.illegal.escape.tach",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hexadecimal.tach",
          "match": "\\b0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*\\b"
        },
        {
          "name": "constant.numeric.integer.binary.tach",
          "match": "\\b0[bB][01](?:_?[01])*\\b"
        },
        {
          "name": "constant.numeric.float.tach",
          "match": "\\b[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)\\b|\\b[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.tach",
          "match": "\\b[0-9](?:_?[0-9])*\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "(@)(docs|workgroup)\\b",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.tach"
            },
            "2": {
              "name": "entity.name.function.decorator.tach"
            }
          }
        },
        {
          "name": "support.function.documentation.tach",
          "match": "\\b(title|summary|field|param|coordinate|returns)(?=\\s*\\()"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(?:(export)\\s+)?(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.export.tach"
            },
            "2": {
              "name": "storage.type.function.tach"
            },
            "3": {
              "name": "entity.name.function.tach"
            }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.tach"
            },
            "2": {
              "name": "entity.name.type.tach"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.tach"
            },
            "2": {
              "name": "variable.other.constant.tach"
            }
          }
        },
        {
          "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.tach"
            },
            "2": {
              "name": "variable.other.readwrite.tach"
            }
          }
        },
        {
          "match": "\\b(run)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.tach"
            },
            "2": {
              "name": "entity.name.function.tach"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tach",
          "match": "\\b(import|export|function|type|run|over|if|else|while|for|break|continue|return)\\b"
        },
        {
          "name": "storage.modifier.tach",
          "match": "\\b(const|let)\\b"
        },
        {
          "name": "constant.language.boolean.tach",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.tach",
          "match": "\\b(void|bool|int32|uint32|float16|float32|vec|buffer|shared|atomic|transient)\\b"
        },
        {
          "name": "entity.name.type.tach",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.tach",
          "match": "\\b(vec|abs|floor|ceil|trunc|sin|cos|tan|exp|exp2|log|log2|sqrt|rsqrt|pow|min|max|clamp|fma|dot|length|distance|cross|normalize|ceilDiv|workgroupBarrier|bufferBarrier|atomicLoad|atomicStore|atomicAdd|atomicSub|atomicMin|atomicMax|atomicAnd|atomicOr|atomicXor|atomicExchange)(?=\\s*\\()"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "variable.other.property.tach",
          "match": "(?<=\\.)[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "entity.name.function.call.tach",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tach",
          "match": "<<=|>>=|\\+\\+|--|==|!=|<=|>=|&&|\\|\\||<<|>>|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|[=+\\-*/%!<>&|^~?:]"
        }
      ]
    }
  }
}
