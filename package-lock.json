{
  "name": "tach-workspace",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "tach-workspace",
      "version": "0.0.0",
      "license": "AGPL-3.0-only",
