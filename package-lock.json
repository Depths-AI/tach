{
  "name": "tach-workspace",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "tach-workspace",
      "version": "0.0.0",
      "license": "AGPL-3.0-only",
      "workspaces": [
        "tach-ts",
        "browser-test",
        "deno-test",
        "showcase-ts"
      ]
    },
    "browser-test": {
      "name": "@tach/browser-test",
      "version": "0.0.0",
      "license": "AGPL-3.0-only",
      "dependencies": {
        "@depths/tach": "0.2.0"
      }
    },
    "deno-test": {
      "name": "@tach/deno-test",
      "version": "0.0.0",
      "license": "AGPL-3.0-only",
      "dependencies": {
        "@depths/tach": "0.2.0"
      }
    },
    "node_modules/@depths/tach": {
      "resolved": "tach-ts",
      "link": true
    },
    "node_modules/@tach/browser-test": {
      "resolved": "browser-test",
      "link": true
    },
    "node_modules/@tach/deno-test": {
      "resolved": "deno-test",
      "link": true
    },
    "node_modules/@tach/showcase-ts": {
      "resolved": "showcase-ts",
      "link": true
    },
    "showcase-ts": {
      "name": "@tach/showcase-ts",
      "version": "0.0.0",
      "license": "AGPL-3.0-only",
      "dependencies": {
        "@depths/tach": "0.2.0"
      }
    },
    "tach-ts": {
      "name": "@depths/tach",
      "version": "0.2.0",
      "license": "AGPL-3.0-only",
      "bin": {
        "tach": "dist/cli.js"
      }
    }
  }
}
